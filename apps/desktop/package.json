{
  "name": "@stardraft/desktop",
  "productName": "Stardraft",
  "version": "0.1.2",
  "private": true,
  "description": "Stardraft 데스크톱 앱",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node -e \"require('electron')\" && electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder --publish never",
    "verify:mac": "node scripts/verify-mac-build.mts && node scripts/verify-app-icon.mts",
    "release:keygen": "node scripts/release-keygen.mts",
    "release:check": "node scripts/release-update-info.mts check",
    "release:sign": "node scripts/release-update-info.mts sign",
    "release:verify": "node scripts/release-update-info.mts verify",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "icons:generate": "node scripts/generate-tray-icons.mts",
    "icons:check": "node scripts/generate-tray-icons.mts --check && node scripts/generate-app-icon.mts --check",
    "app-icon:generate": "node scripts/generate-app-icon.mts",
    "preview:tray": "node scripts/preview-tray.mts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.17.0",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "js-yaml": "4.3.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "electron-updater": "6.8.10"
  }
}
