---
import { CopyButton } from './CopyButton';

/** Claude Code 설치 명령. 데스크톱 앱의 연결 안내 카드와 같은 명령이다. */
const claudeInstall = [
  { shell: 'macOS 터미널', command: 'curl -fsSL https://claude.ai/install.sh | bash' },
  { shell: 'Windows PowerShell', command: 'irm https://claude.ai/install.ps1 | iex' },
];
/** Claude Code 로그인 명령. */
const claudeLogin = 'claude auth login';
---

<ul class="pre-list">
  <li>
    <b>Flow 개인 API 키</b>
    <span>Flow에서 발급합니다. Stardraft를 처음 켤 때 넣으면 내 이름과 소속이 보이는지로 맞는 키인지 확인합니다.</span>
  </li>
  <li>
    <b>Claude Code 설치와 로그인</b>
    <span>Stardraft는 내 PC의 Claude Code로 초안을 씁니다. 설치한 뒤 터미널에서 로그인해 두세요.</span>
    <div class="cmds">
      {
        claudeInstall.map(({ shell, command }) => (
          <div class="cmd">
            <span>{shell}</span>
            <code>{command}</code>
            <CopyButton client:visible text={command} />
          </div>
        ))
      }
      <div class="cmd">
        <span>로그인</span>
        <code>{claudeLogin}</code>
        <CopyButton client:visible text={claudeLogin} />
      </div>
    </div>
  </li>
</ul>
