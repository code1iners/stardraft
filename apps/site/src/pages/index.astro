---
import appIconUrl from '../../../desktop/build/icon.png?url';
import { VERCEL_GIT_REPO_OWNER } from 'astro:env/server';
import Prerequisites from '../components/Prerequisites.astro';
import Tutorial from '../components/Tutorial.astro';
import Uninstall from '../components/Uninstall.astro';
import UpdateSection from '../components/UpdateSection.astro';
import { Changelog } from '../components/Changelog';
import { CurrentFiles } from '../components/CurrentFiles';
import { DownloadHero } from '../components/DownloadHero';
import { InstallGuide } from '../components/InstallGuide';
import { releaseListUrl, repoUrl } from '../lib/releases';
import '../styles/global.css';

/** 소스 코드가 있는 GitHub 저장소 주소. */
const sourceUrl = repoUrl(VERCEL_GIT_REPO_OWNER);
/** GitHub Release 목록 주소. */
const releasesUrl = releaseListUrl(VERCEL_GIT_REPO_OWNER);
/** 한 줄 소개. 기능 홍보 없이 무엇인지만 적는다. */
const intro = '업무 중 받은 질문에 대해, 내 PC의 코드 저장소를 읽고 근거가 있는 답변 초안을 만들어 주는 앱입니다.';

/** 목차. id는 앱이 여는 섹션 주소(#update, #changelog)와 같다. */
const sections = [
  { id: 'about', title: 'Stardraft란?' },
  { id: 'download', title: '다운로드' },
  { id: 'prerequisites', title: '설치 전에 필요한 것' },
  { id: 'install', title: '설치 안내' },
  { id: 'update', title: '업데이트' },
  { id: 'changelog', title: '변경 내역' },
  { id: 'versions', title: '이전 버전과 SHA256' },
  { id: 'uninstall', title: '삭제' },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Stardraft 다운로드</title>
    <meta name="description" content={intro} />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" type="image/png" href={appIconUrl} />
  </head>
  <body>
    <header class="topbar">
      <div class="wrap">
        <a class="brand" href="#about"><img src={appIconUrl} width="26" height="26" alt="" />Stardraft</a>
        <nav class="topnav" aria-label="바로 가기">
          <a href="#install">설치 안내</a>
          <a href="#changelog">변경 내역</a>
          <a class="keep" href={sourceUrl}>GitHub</a>
        </nav>
      </div>
    </header>

    <div class="wrap layout">
      <nav class="toc" aria-label="목차">
        {sections.map(({ id, title }) => <a href={`#${id}`} data-toc={id}>{title}</a>)}
      </nav>
      <main>
        <section id="about">
          <h1>Stardraft란?</h1>
          <p class="lead">{intro}</p>
          <Tutorial />
        </section>

        <section id="download" class="first">
          <DownloadHero client:load />
          <p class="note">
            Stardraft는 유료 인증서로 서명하지 않은 오픈소스 앱이라, 설치할 때 macOS와 Windows가 경고를 띄웁니다.
            이 주소에서 받은 파일만 설치하세요.
          </p>
        </section>

        <section id="prerequisites">
          <h2>설치 전에 필요한 것</h2>
          <Prerequisites />
        </section>

        <section id="install">
          <h2>설치 안내</h2>
          {/* 첫 화면의 다운로드 링크가 고른 OS를 바로 들어야 해서 보이기 전에 깨운다. */}
          <InstallGuide client:load />
        </section>

        <section id="update">
          <h2>업데이트</h2>
          <UpdateSection />
        </section>

        <section id="changelog">
          <h2>변경 내역</h2>
          <Changelog client:visible releaseListUrl={releasesUrl} />
        </section>

        <section id="versions">
          <h2>이전 버전과 SHA256</h2>
          <CurrentFiles client:visible />
          <p>
            이전 버전은 <a class="link" href={releasesUrl}>GitHub Release 목록</a>에서 받습니다. 옛 버전을 설치했을 때 새 버전이 만든
            데이터가 있으면, Stardraft는 켜지지 않고 새 버전을 다시 설치하라고 알립니다. 데이터는 지우지 않으므로 새 버전을 다시 설치하면
            그대로 이어서 씁니다.
          </p>
        </section>

        <section id="uninstall">
          <h2>삭제</h2>
          <Uninstall />
        </section>
      </main>
    </div>

    <footer class="foot">
      <div class="wrap">Stardraft · MIT 라이선스 · <a href={sourceUrl}>소스 코드</a></div>
    </footer>

    <script>
      // 읽는 중인 섹션을 목차에 표시한다.
      /** 목차 링크. */
      const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
      /** 화면 위쪽 30% 줄에 걸친 섹션을 지금 섹션으로 본다. */
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            for (const link of links) {
              if (link.dataset.toc === entry.target.id) link.setAttribute('aria-current', 'true');
              else link.removeAttribute('aria-current');
            }
          }
        },
        { rootMargin: '-30% 0px -65% 0px' },
      );
      for (const section of document.querySelectorAll('main > section')) observer.observe(section);
    </script>
  </body>
</html>
